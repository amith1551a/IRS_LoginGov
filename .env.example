# ZITADEL OIDC configuration
OIDC_ISSUER=https://etelligent-group.dev:8083
OIDC_CLIENT_ID=COPY_FROM_ZITADEL
OIDC_REDIRECT_URI=https://etelligent-group.dev/iam-demo/auth/callback
OIDC_POST_LOGOUT_URI=https://etelligent-group.dev/iam-demo/auth/callback

# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=GENERATE_A_LONG_RANDOM_VALUE

# Application
APP_HOST=127.0.0.1
APP_PORT=8088
APP_ROOT_PATH=/iam-demo

# Set to false only for local HTTP testing; keep true for production.
SESSION_HTTPS_ONLY=true
